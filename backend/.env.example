APP_NAME=RAG Based Multi-LLM Personalized Learning Platform
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRY_MINUTES=1440
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql+pg8000://postgres:postgres@localhost:5432/rag_db

# --- API Keys ---
GEMINI_API_KEY=your-gemini-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# --- Model Names ---
# Analyst Agent (Generator): Uses Gemini
GEMINI_MODEL=gemini-1.5-flash
# Optimizer Agent (GPT-4): Uses OpenRouter, temperature=1.0 for creativity
OPENROUTER_OPTIMIZER_MODEL=openai/gpt-4o
# Evaluator Agent (Meta-Llama-3-70B): Uses OpenRouter, temperature=0.0 for stability
OPENROUTER_EVALUATOR_MODEL=meta-llama/llama-3-70b-instruct:nitro

# --- LLM Runtime Settings ---
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LANGGRAPH_MAX_ITERATIONS=15
